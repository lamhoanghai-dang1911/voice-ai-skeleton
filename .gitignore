# ==========================================
# INTEGRIX IX.VOICE - GIT IGNORE
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
coverage.xml

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
*.local

# Audio data & Local storage
data/audio/*
!data/audio/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/storage/*
!data/storage/.gitkeep
data/models/*
!data/models/.gitkeep

# AI Model weights & Pretrained weights (PhoWhisper, Whisper, Silero, pyannote)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
huggingface_cache/
torch_cache/

# Databases & local state
*.sqlite3
*.db
redis_data/

# IDE & OS files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
