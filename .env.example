# ==============================================================================
# INTEGRIX IX.VOICE - SAFE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to `.env` for local development: `cp .env.example .env`
# 2. DO NOT commit `.env` into git repository.
# 3. This template contains ONLY dummy/placeholder safe values suitable for local-first testing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="INTEGRIX IX.VOICE"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO

# Security / Secret Key (Random string for JWT/Session signing in local dev)
SECRET_KEY=dev-insecure-secret-key-change-in-production-integrix-ix-voice-2026
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Backend API Service
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 3. Redis / Task Queue (Celery Broker & Result Backend)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Note: For running locally without docker, change REDIS_HOST to localhost:
# CELERY_BROKER_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Storage & Audio Limits
# ------------------------------------------------------------------------------
# Local directory path where uploaded audio files and artifacts are stored
STORAGE_LOCAL_DIR=./data/storage
MAX_AUDIO_SIZE_MB=100
MAX_AUDIO_DURATION_MINUTES=60
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.aac,.flac,.ogg

# ------------------------------------------------------------------------------
# 5. Speech AI & Pipeline Mode
# ------------------------------------------------------------------------------
# PIPELINE_MODE: "mock" (fast local testing with fixtures) or "real" (load actual models)
PIPELINE_MODE=mock

# Device: "cpu" or "cuda" (for GPU acceleration)
DEVICE=cpu

# Model configurations (Candidate OSS models per Charter v1.1 section 6.3)
VAD_MODEL=silero_vad
ASR_MODEL=PhoWhisper-small
DIARIZATION_MODEL=pyannote-community-1
EMOTION_BACKEND=librosa_acoustic

# Hugging Face token (Optional: only needed if using pyannote community models with gated access)
# LEAVE EMPTY in .env.example
HF_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCK_FALLBACK=true
